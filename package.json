{
  "name": "dm-holdfast",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "api",
    "packages/types"
  ],
  "scripts": {
    "check:env": "node scripts/validate-env.mjs",
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "start:web": "npm run check:env && npm --workspace apps/web run start",
    "lint": "npm --workspace apps/web run lint",
    "dev:api": "npm --workspace api run dev",
    "build:api": "npm --workspace api run build",
    "start:api": "npm run check:env && npm --workspace api run start"
  },
  "dependencies": {
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/supabase-js": "^2.80.0",
    "autoprefixer": "^10.4.21",
    "next": "^16.0.1",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17"
  }
}
